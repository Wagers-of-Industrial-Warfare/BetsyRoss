{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "Betsy Ross",
  "description": "${description}",
  "authors": [],
  "contact": {},

  "license": "MIT",
  "icon": "logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "rbasamoyai.betsyross.fabric.BetsyRossFabric"
    ],
    "client": [
      "rbasamoyai.betsyross.fabric.BetsyRossClientFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": "*",
    "fabricloader": ">=${fabric_loader_version}",
    "immersive_paintings": ">=${immersive_paintings_fabric_requirement}",
    "fzzy_config": ">=${fzzy_config_fabric_requirement}"
  },
  "breaks": {
    "trinkets": "<${trinkets_breaking}"
  }
}
